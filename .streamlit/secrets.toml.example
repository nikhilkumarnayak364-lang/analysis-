# Streamlit Secrets configuration for MongoDB
# Copy this content into .streamlit/secrets.toml and replace with your real connection details.

MONGODB_URI = "mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority"
MONGODB_DB_NAME = "retail_db"
MONGODB_COLLECTION_NAME = "sales_transactions"
