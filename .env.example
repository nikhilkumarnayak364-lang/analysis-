# MongoDB Atlas / Local MongoDB Connection Settings
# Replace with your actual MongoDB connection string:
# Example for Atlas: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority&readPreference=primaryPreferred
# Example for Local: mongodb://localhost:27017

MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority&readPreference=primaryPreferred
MONGODB_DB_NAME=retail_db
MONGODB_COLLECTION_NAME=sales_transactions
